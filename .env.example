# ─── DAS RPC (how the indexer reads the collection) ──────────────────────────
# The indexer scans the Token-2022 collection via the DAS getAssetsByGroup
# method, which Helius serves. Same key convention as iq-gateway: set ONE of
# these. HELIUS_API_KEYS (comma-separated) rotates on 429.
#   https://{mainnet|devnet}.helius-rpc.com/?api-key=KEY   ← built from these
SOLANA_CLUSTER=mainnet-beta
# HELIUS_API_KEY=your-key-here
# HELIUS_API_KEYS=key1,key2,key3

# Fallback DAS endpoint if no Helius key is set. Any RPC that supports the DAS
# API works here. Without DAS support the ingest job stays empty (a real,
# visible state — clients then fall back to their own RPC, see README §Fallback).
# DAS_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=...

# ─── Which collections to index ──────────────────────────────────────────────
# The umbrella collection mints (Token-2022). AgentNet has exactly two today:
# skills and workflows (see AgentNet plans/onchain-format/tables.md §1).
# Comma-separated mint addresses; the `type` label is attached per collection.
# SKILLS_COLLECTION=<skills collection mint>
# WORKFLOWS_COLLECTION=<workflows collection mint>

# ─── Ingest cadence ──────────────────────────────────────────────────────────
# Full collection re-scan interval. supply is the ranking signal and changes on
# every buy, so refresh often enough that the ordering stays fresh.
# INGEST_INTERVAL_MS=600000   # 10 min

# ─── Server ──────────────────────────────────────────────────────────────────
# PORT=3009            # host port on iqlabs-prod-01 (Caddy → :3009)
# DB_PATH=./data/index.db   # resolves to /app/data/index.db in the container (mounted volume)
